    "빈 곳을 탭하면 중단": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap empty space to stop"
          }
        }
      }
    },
    "빈 곳을 탭하면 중단 · 항목을 두 번 탭하면 바로 실행": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap empty space to stop · double-tap an item to run it"
