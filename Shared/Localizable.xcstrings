          "stringUnit": {
            "state": "translated",
            "value": "Cycle order"
          }
        }
      }
    },
    "순환으로 인정된 횟수": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presses counted as cycling"
          }
        }
      }
