    "선택한 액션이 사라졌습니다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected action no longer exists"
          }
        }
      }
    },
    "설정 > Cue 에서 '실시간 현황'을 켜야 Live Activity가 뜹니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live Activities in Settings › Cue for the card to appear."
          }
        }
      }
    },
