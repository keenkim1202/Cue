# 이 파일을 fastlane/.env 로 복사한 뒤 값을 채운다. .env 는 gitignore 대상.
# App Store Connect > 사용자 및 액세스 > 통합 > App Store Connect API 에서 발급.

# 내려받은 .p8 파일 경로. ~ 로 시작해도 된다.
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# 키 목록의 '키 ID' 열
ASC_KEY_ID=XXXXXXXXXX

# 키 목록 위쪽에 한 번만 표시되는 'Issuer ID'
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
